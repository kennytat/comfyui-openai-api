# Copy to .env and fill in. Only the gateway variables below reach the gateway
# container (explicit `environment:` in docker-compose.yml, no env_file).

# --- Required -------------------------------------------------------------
# Comma-separated Bearer keys accepted by /v1/*. Generate: openssl rand -hex 32
API_KEYS=
# Public base URL for url-format images, no trailing slash. Required when ENABLE_URL_FORMAT=true.
# https:// for the tunnel; http:// only allowed for localhost/127.0.0.1 (local testing).
PUBLIC_BASE_URL=http://127.0.0.1:8001
# Host port for the gateway (bound to 127.0.0.1)
GATEWAY_PORT=8001
# Host RAM limit of the ComfyUI container (qwen-image needs ~32 GB; Flux models ~20 GB)
COMFYUI_MEM_LIMIT=40g

# --- Secrets for other services (never passed to the gateway) -------------
HF_TOKEN=
TUNNEL_TOKEN=

# --- Gateway tunables (defaults shown) ------------------------------------
ENABLE_URL_FORMAT=true
DEFAULT_MODEL=sdxl
DEFAULT_RESPONSE_FORMAT=b64_json
MAX_N=4
MAX_PROMPT_CHARS=4000
# 1 MiB for the JSON routes (generations)
MAX_BODY_BYTES=1048576
# Per uploaded file on /v1/images/edits and /v1/images/variations (4 MiB, OpenAI dall-e-2 limit)
MAX_UPLOAD_BYTES=4194304
# Whole multipart body; 0 = 2 * MAX_UPLOAD_BYTES + 64 KiB (image + mask + fields)
MAX_MULTIPART_BYTES=0
# Decompression-bomb guard for uploads (width * height), 16 MP
MAX_INPUT_PIXELS=16777216
# Uploads decoded/resized at once; extra edits/variations get 429 queue_full
MAX_CONCURRENT_PREPROCESS=2
# Max seconds the GPU worker waits for a job's input upload to ComfyUI (then 503)
UPLOAD_WAIT_S=15
QUEUE_MAX_DEPTH=8
# Must be <= 95 (Cloudflare tunnel origin timeout ~100 s)
REQUEST_TIMEOUT_S=90
POSTPROCESS_RESERVE_S=10
EST_JOB_OVERHEAD_S=3
EST_EXTERNAL_JOB_S=30
EST_AUTOCALIBRATE=true
EST_EWMA_ALPHA=0.2
EST_SCALE_MIN=0.75
EST_SCALE_MAX=1.5
EST_CALIBRATION_MIN_SAMPLES=3
# Per-API-key requests/minute on the image endpoints (0 = off); burst 0 = max(1, rpm)
RATE_LIMIT_RPM=0
RATE_LIMIT_BURST=0
ENABLE_METRICS=true
POLL_INTERVAL_S=0.5
COMFY_QUEUE_POLL_S=2
IMAGE_URL_TTL_S=3600
CLEANUP_COMFY_OUTPUTS=true
ORPHAN_MAX_AGE_S=3600
# Stray uploaded inputs (input/openai-api) are swept after this many seconds
INPUT_ORPHAN_MAX_AGE_S=300
MODEL_CHECK_TTL_S=60
MODEL_REFRESH_MIN_INTERVAL_S=5
LOG_LEVEL=info
